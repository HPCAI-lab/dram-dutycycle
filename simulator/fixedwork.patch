+void TraceBasedCPU::ReadCallBack(uint64_t addr) {
+    done_reads_++;
+    auto it = read_arrival_.find(addr);
+    if (it != read_arrival_.end() && !it->second.empty()) {
+        read_lat_arrival_.push_back(clk_ - it->second.front());
+        it->second.pop_front();
+        if (it->second.empty()) read_arrival_.erase(it);
+    }
+}
+
+void TraceBasedCPU::WriteCallBack(uint64_t addr) { done_writes_++; }
+
+bool TraceBasedCPU::Done() const {
+    return exhausted_ && !have_trans_ && memory_system_.IsIdle();
+}
+
+void TraceBasedCPU::PrintCpuStats(const std::string& path) const {
+    std::vector<uint64_t> v(read_lat_arrival_);
+    std::sort(v.begin(), v.end());
+    double sum = 0;
+    for (auto x : v) sum += x;
+    auto pct = [&](double q) -> uint64_t {
+        if (v.empty()) return 0;
+        size_t i = static_cast<size_t>(q * (v.size() - 1) + 0.5);
+        return v[i];
+    };
+    std::ofstream o(path);
+    o << "{\n"
+      << "  \"added_reads\": " << added_reads_ << ",\n"
+      << "  \"added_writes\": " << added_writes_ << ",\n"
+      << "  \"done_reads\": " << done_reads_ << ",\n"
+      << "  \"done_writes\": " << done_writes_ << ",\n"
+      << "  \"trace_exhausted\": " << (exhausted_ ? "true" : "false") << ",\n"
+      << "  \"memory_idle\": " << (memory_system_.IsIdle() ? "true" : "false") << ",\n"
+      << "  \"final_cycle\": " << clk_ << ",\n"
+      << "  \"first_trace_cycle\": " << first_trace_cycle_ << ",\n"
+      << "  \"last_trace_cycle\": " << last_trace_cycle_ << ",\n"
+      << "  \"stall_cycles\": " << stall_cycles_ << ",\n"
+      << "  \"rw_fallbacks\": " << memory_system_.RwFallbacks() << ",\n"
+      << "  \"read_lat_from_arrival_count\": " << v.size() << ",\n"
+      << "  \"read_lat_from_arrival_mean\": " << (v.empty() ? 0.0 : sum / v.size()) << ",\n"
+      << "  \"read_lat_from_arrival_p50\": " << pct(0.50) << ",\n"
+      << "  \"read_lat_from_arrival_p95\": " << pct(0.95) << ",\n"
+      << "  \"read_lat_from_arrival_p99\": " << pct(0.99) << ",\n"
+      << "  \"read_lat_from_arrival_max\": " << (v.empty() ? 0 : v.back()) << "\n"
+      << "}\n";
+}
+
 }  // namespace dramsim3
