; Two MD steps for tracing: step 0 (pair search, energies), step 1 (steady-state force-only step)
integrator      = md
dt              = 0.002
nsteps          = 2
cutoff-scheme   = Verlet
nstlist         = 10
coulombtype     = PME
rcoulomb        = 1.0
rvdw            = 1.0
fourierspacing  = 0.125
pme-order       = 4
tcoupl          = v-rescale
tc-grps         = System
tau-t           = 0.1
ref-t           = 300
pcoupl          = no
gen-vel         = yes
gen-temp        = 300
gen-seed        = 1987
nstcalcenergy   = 100
nstenergy       = 0
nstlog          = 0
nstxout         = 0
nstvout         = 0
nstfout         = 0
nstxout-compressed = 0
